# Secret environment variables for local development.
#
# Each variable overrides the config.yaml key it names: the product prefix,
# then the key with its dots as underscores (db.source.host is
# FRAMINGO_EXAMPLE_DB_SOURCE_HOST), and it wins over the file. A binary built
# with plain `go build` has no product name injected and so no prefix: it
# reads DB_SOURCE_HOST and so on.
#
# Two readers: the shell, before running the daemon
#   set -a; . env/local/config/exampleapp/secret.env; set +a
# and gopro's FromSecretEnv, which the docker compose template takes the
# database credentials from at generate time.

# Database credentials
FRAMINGO_EXAMPLE_DB_SOURCE_HOST=localhost
FRAMINGO_EXAMPLE_DB_SOURCE_PORT=5432
FRAMINGO_EXAMPLE_DB_SOURCE_USER=framingo
FRAMINGO_EXAMPLE_DB_SOURCE_PASSWORD=framingo_dev
FRAMINGO_EXAMPLE_DB_SOURCE_DBNAME=framingo_example

# API configuration
FRAMINGO_EXAMPLE_API_HTTP_HOST=0.0.0.0
FRAMINGO_EXAMPLE_API_HTTP_PORT=8080
