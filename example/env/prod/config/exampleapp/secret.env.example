# Copy to secret.env beside this file and fill in - secret.env is gitignored.
# Provision it from your secrets manager before `gopro generate kubernetes -e
# prod` and discard it afterwards: the Kubernetes templates read the database
# credentials from it (FromSecretEnv) into the Secret they render. Without it
# generation fails rather than rendering an empty password.

FRAMINGO_EXAMPLE_DB_SOURCE_USER=
FRAMINGO_EXAMPLE_DB_SOURCE_PASSWORD=
